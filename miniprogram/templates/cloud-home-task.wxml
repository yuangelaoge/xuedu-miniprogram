<!-- Pass the task explicitly; do not depend on an include inheriting wx:for scope. -->
<template name="cloud-home-task">
    <view class="task-topline">
      <view class="task-class">{{task.classLabel}}</view>
      <view class="task-status {{task.done ? 'task-status-done' : ''}}"><view class="task-status-dot"></view>{{task.done ? '已提交' : task.status === 'pendingAdjustment' ? '待调整' : '待完成'}}</view>
    </view>
    <view class="task-course">{{task.course.name}}</view>
    <view class="task-detail"><text class="task-detail-label">时间</text><text class="task-detail-value">{{task.timeLabel}}</text></view>
    <view class="task-detail"><text class="task-detail-label">地点</text><text class="task-detail-value">{{task.course.classroom}}</text></view>
    <view class="task-detail"><text class="task-detail-label">教师</text><text class="task-detail-value">{{task.course.teacher}}</text></view>
    <view wx:for="{{task.courseCounts}}" wx:for-item="count" wx:key="id" class="course-meta">
      <view wx:if="{{task.courseCounts.length > 1}}">{{count.label}}</view>
      <view>课表人数：{{count.count}}{{count.combined ? '（合班合计）' : ''}}</view>
    </view>
    <view class="task-bottom">
      <text class="task-hint">{{task.done ? '本次听课已记录' : '听课后记得上传签字表'}}</text>
      <button wx:if="{{task.status === 'confirmed'}}" class="task-button" hover-class="home-pressed" data-id="{{task.id}}" bindtap="open">填写记录<text class="button-arrow">→</text></button>
      <button wx:elif="{{task.done && task.recordId}}" class="task-button task-button-done" hover-class="home-pressed" data-id="{{task.recordId}}" data-target="record" bindtap="open">查看记录<text class="button-arrow">→</text></button>
      <button wx:else class="task-button task-button-done" data-target="schedule" bindtap="navigate">查看安排<text class="button-arrow">→</text></button>
    </view>
</template>
