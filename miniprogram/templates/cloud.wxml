<view class="v2-page">
  <view class="v2-heading">{{title}}</view>
  <view wx:if="{{error}}" class="v2-error">{{error}}<button size="mini" bindtap="refreshWeek">重新加载</button></view>
  <view wx:if="{{busy}}" class="v2-note">正在处理，请稍候…</view>
  <view wx:if="{{maintenance}}" class="v2-card">
    <view class="v2-title">业务数据维护中</view><view>写入已冻结，管理员可在清空入口继续处理同一任务。</view>
    <button wx:if="{{admin}}" type="warn" disabled="{{busy}}" bindtap="clearBusiness">继续业务清空</button>
  </view>
  <view wx:elif="{{!memberId}}" class="v2-card">
    <view class="v2-title">{{status === 'needsAdministrator' ? '首次安装' : status === 'preparing' ? '组织正在准备新学期' : '加入学风督察小组'}}</view>
    <block wx:if="{{status === 'needsAdministrator'}}">
      <view>{{canInitialize ? '请填写真实学期、本人班级及本人资料，一次完成首位管理员登记。' : '请等待指定的初始化微信完成登记。'}}</view>
      <button wx:if="{{canInitialize}}" type="primary" data-type="initialize" bindtap="newForm">首次登记</button>
    </block>
    <view wx:elif="{{removed}}">成员资格已停用，请联系管理员核实并恢复。</view>
    <block wx:elif="{{status === 'ready'}}">
      <view wx:for="{{rows}}" wx:key="id">本人申请：{{item.label}} · {{item.status === 'pending' ? '待审核' : item.status === 'rejected' ? '已驳回' : item.status}} {{item.detail}}</view>
      <button data-type="join" bindtap="newForm">填写／重新提交入组申请</button>
      <button data-type="rebindRequest" bindtap="newForm">原成员申请微信换绑</button>
      <view class="v2-note">换绑须经管理员线下核实，姓名和学号不能用于自行认领账号。</view>
    </block>
  </view>
  <block wx:elif="{{!maintenance}}">
    <view wx:if="{{!activeSemesterId}}" class="v2-card">
      <view class="v2-title">尚未启用学期</view>
      <view>{{admin ? '管理员与绑定班级已保留。请建立学期草稿、选择参与班级并启用学期。班级可以独立建立。' : '请等待管理员完成新学期准备。'}}</view>
      <button wx:if="{{admin}}" data-target="manage" bindtap="navigate">进入管理工作台</button>
    </view>
    <view wx:if="{{view === 'profile'}}" class="v2-card">
      <view class="v2-title">{{memberName}}</view><view>{{role === 'admin' ? '管理员' : role === 'leader' ? '组部长' : '普通成员'}}</view>
      <button wx:if="{{manager}}" data-target="manage" bindtap="navigate">管理工作台</button>
      <button wx:if="{{admin}}" bindtap="stepDown">本人卸任管理员</button>
      <view class="v2-note">云端数据按微信身份授权。本机查看学期与草稿不影响其他成员。</view>
    </view>
    <view wx:if="{{view !== 'profile' && view !== 'join' && view !== 'record' && view !== 'submission'}}" class="v2-card">
      <view class="v2-label">{{view === 'home' || view === 'availability' ? '组织当前学期' : '查看学期（仅影响本机）'}}</view>
      <picker wx:if="{{view !== 'home' && view !== 'availability'}}" range="{{semesterOptions}}" range-key="label" value="{{semesterIndex}}" bindchange="chooseSemester"><view class="v2-picker">{{semesterName}} ▾</view></picker>
      <view wx:else>{{semesterName}}</view>
      <button wx:if="{{semesterCursor}}" size="mini" bindtap="moreSemesters">加载更早学期</button>
      <view wx:if="{{semesterId && (view === 'home' || view === 'schedule' || view === 'records' || view === 'availability')}}" class="v2-actions"><text>第</text><input class="v2-week" type="number" value="{{week}}" bindinput="weekChange"/><text>周</text><button size="mini" bindtap="refreshWeek">查看</button></view>
    </view>
    <view wx:if="{{view === 'home'}}" class="v2-actions"><button data-target="availability" bindtap="navigate">填写无课时间</button><button data-target="courses" bindtap="navigate">课程总表</button><button wx:if="{{manager}}" data-target="manage" bindtap="navigate">管理工作台</button></view>
    <block wx:if="{{view === 'home' || view === 'schedule'}}">
      <view wx:if="{{manager && semesterId}}" class="v2-actions"><button disabled="{{busy}}" bindtap="generate">生成排班草稿</button><button bindtap="adjust">补排任务</button><button wx:if="{{admin}}" bindtap="skipWeek">跳过本周</button></view>
      <view wx:if="{{weekData.draft}}" class="v2-card">
        <view class="v2-title">待人工确认的调整草稿</view><view>{{weekData.draft.data.reason}}</view>
        <view wx:for="{{tasks}}" wx:key="id" wx:if="{{item.status === 'draft' && item.parentId === weekData.draft.id}}" class="v2-row"><view>{{item.label}}</view><view>{{item.detail}}</view><view>{{item.cancel ? '取消原任务' : '拟安排'}}{{item.replaces ? '（替换原任务）' : ''}}</view></view>
        <view wx:for="{{weekData.uncovered}}" wx:key="label">未覆盖：{{item.label}} · {{item.reason}}</view>
        <button wx:if="{{manager}}" type="primary" bindtap="confirmPlan">确认后生效</button>
      </view>
      <view wx:if="{{weekData.plan.data.status === 'skipped'}}" class="v2-note">本周已跳过：{{weekData.plan.data.reason}}</view><view class="v2-title">本周任务</view>
      <view wx:for="{{tasks}}" wx:key="id" wx:if="{{item.status === 'confirmed' || item.status === 'submitted' || item.status === 'pendingAdjustment'}}" class="v2-card">
        <view class="v2-title">{{item.label}}</view><view>{{item.detail}}</view><view>{{item.status === 'pendingAdjustment' ? '待调整：原课表已失效，暂不能提交' : item.status === 'submitted' ? '已提交' : '已确认'}}</view>
        <button wx:if="{{item.status === 'confirmed' && item.memberId === memberId}}" data-id="{{item.id}}" bindtap="open">填写听课记录</button>
        <button wx:if="{{manager && item.status !== 'submitted'}}" data-id="{{item.id}}" bindtap="adjust">转派／取消</button>
      </view>
      <view wx:if="{{!tasks.length}}" class="v2-note">本周暂无任务。未排班不计为出勤率为零。</view>
    </block>
    <view wx:if="{{view === 'availability' && semesterId}}" class="v2-card">
      <view class="v2-title">勾选完整可听课时间</view>
      <label wx:if="{{role !== 'member'}}"><switch checked="{{optedIn}}" bindchange="optIn"/>本周我也听课</label>
      <checkbox-group bindchange="slotsChange"><view class="v2-slot-grid"><label wx:for="{{slots}}" wx:key="key"><checkbox value="{{item.key}}" checked="{{item.checked}}"/>{{item.label}}</label></view></checkbox-group>
      <textarea placeholder="备注" value="{{availabilityNote}}" bindinput="availabilityNote"/><button type="primary" bindtap="saveAvailability">保存本周无课时间</button>
    </view>
    <view wx:if="{{view === 'manage'}}" class="v2-actions"><button wx:for="{{sections}}" wx:key="id" wx:if="{{admin || (item.id !== 'classes' && item.id !== 'semesters' && item.id !== 'courses' && item.id !== 'rebindings')}}" size="mini" data-id="{{item.id}}" bindtap="section">{{item.label}}</button></view>
    <view wx:if="{{view === 'manage' && section === 'applications'}}" class="v2-card"><view>已选 {{selectedApplications.length}} 人（仅当前已加载列表）</view><view class="v2-actions"><button size="mini" bindtap="selectAllApplications">全选／取消全选</button><button size="mini" data-action="approve" disabled="{{busy || !selectedApplications.length}}" bindtap="reviewApplications">批量通过</button><button size="mini" data-action="reject" disabled="{{busy || !selectedApplications.length}}" bindtap="reviewApplications">批量驳回</button></view></view>
    <view wx:if="{{admin && view === 'manage'}}" class="v2-actions">
      <button wx:if="{{section === 'classes'}}" data-type="classSave" bindtap="newForm">独立新增班级</button>
      <button wx:if="{{section === 'semesters'}}" data-type="semesterCreate" bindtap="newForm">新建学期草稿</button>
      <block wx:if="{{section === 'courses' && semesterId}}"><button data-type="courseSave" bindtap="newForm">新增课程</button><button data-type="import" bindtap="newForm">JSON课表导入</button></block>
    </view>
    <view wx:if="{{manager && view === 'records' && semesterId}}" class="v2-actions"><button bindtap="showStats">查看本周统计</button><button data-kind="txt" bindtap="exportReport">导出名单 TXT</button><button data-kind="xlsx" bindtap="exportReport">导出汇总 Excel</button></view>
    <view wx:if="{{statsLoaded}}" class="v2-card"><view class="v2-title">本周最新记录统计</view><view>已提交 {{statsCount}} 份记录；出勤率按有效应到、实到人次加权。</view><view wx:for="{{stats}}" wx:key="grade" class="v2-row">{{item.grade}}级：观测 {{item.count}} 次，有效 {{item.valid}} 次，出勤率 {{item.rate}}</view><view class="v2-note">统计仅代表实际听课观测；更正后重新查看或导出即可使用最新数据。</view></view>
    <view wx:if="{{impacts.length}}" class="v2-card"><view class="v2-title">以下任务已标记待调整</view><view>已生成调整草稿，请前往“听课安排”选择相应学期与周次核对并确认。确认前原任务不能提交，已完成任务保持不变。</view><view wx:for="{{impacts}}" wx:key="id" class="v2-row">第 {{item.week}} 周 · {{item.label}} · {{item.detail}}</view></view>
    <block wx:if="{{view === 'manage' || view === 'records' || view === 'courses'}}">
      <view wx:for="{{rows}}" wx:key="id" class="v2-card">
        <view class="v2-title">{{item.label}}</view><view>{{item.detail}}</view>
        <view wx:if="{{section === 'members'}}">{{item.role === 'admin' ? '管理员' : item.role === 'leader' ? '组部长' : '成员'}} · {{item.active ? '有效' : '已停用'}}</view>
        <view wx:if="{{item.status}}">{{item.statusLabel}}</view>
        <button wx:if="{{view === 'records'}}" data-id="{{item.id}}" bindtap="open">查看记录与照片</button>
        <view wx:if="{{view === 'manage'}}" class="v2-actions">
          <block wx:if="{{section === 'members'}}">
            <block wx:if="{{admin && item.active}}"><button wx:if="{{item.role !== 'admin'}}" size="mini" data-id="{{item.id}}" data-action="admin" bindtap="rowAction">授予管理员</button><button wx:if="{{item.role !== 'member'}}" size="mini" data-id="{{item.id}}" data-action="member" bindtap="rowAction">降为成员</button><button wx:if="{{item.role === 'member'}}" size="mini" data-id="{{item.id}}" data-action="leader" bindtap="rowAction">设为组部长</button></block>
            <button wx:if="{{item.active && (admin || item.role === 'member')}}" size="mini" data-id="{{item.id}}" data-action="remove" bindtap="rowAction">停用</button>
            <button wx:if="{{admin && !item.active}}" size="mini" data-id="{{item.id}}" data-action="restore" bindtap="rowAction">恢复资格</button>
          </block>
          <block wx:if="{{section === 'applications' && item.status === 'pending'}}"><button size="mini" data-id="{{item.id}}" bindtap="selectApplication">{{item.selected ? '已选择 ✓' : '选择'}}</button><button size="mini" data-id="{{item.id}}" data-action="approve" bindtap="rowAction">通过</button><button size="mini" data-id="{{item.id}}" data-action="reject" bindtap="rowAction">驳回</button></block>
          <button wx:if="{{section === 'rebindings' && admin && item.status === 'pending'}}" data-id="{{item.id}}" data-action="rebind" bindtap="rowAction">线下核实后确认换绑</button>
          <block wx:if="{{admin && (section === 'classes' || section === 'courses')}}"><button size="mini" data-id="{{item.id}}" bindtap="edit">编辑</button><button wx:if="{{section === 'classes' || item.active}}" size="mini" data-id="{{item.id}}" data-action="{{item.active ? 'disable' : 'enable'}}" bindtap="rowAction">{{item.active ? '停用' : '启用'}}</button><button wx:if="{{section === 'courses'}}" size="mini" data-id="{{item.id}}" data-action="exception" bindtap="rowAction">停课／调课／补课</button></block>
          <block wx:if="{{section === 'semesters' && admin}}"><button size="mini" data-id="{{item.id}}" data-action="participants" bindtap="rowAction">选择参与班级</button><button wx:if="{{item.id !== activeSemesterId}}" size="mini" data-id="{{item.id}}" data-action="activate" bindtap="rowAction">启用为当前学期</button><text wx:else>组织当前学期</text></block>
        </view>
      </view>
      <view wx:if="{{!rows.length && !busy}}" class="v2-note">{{view === 'courses' || section === 'courses' ? '暂无课程，管理员可先建立班级，再配置参与班级和课程。' : '暂无资料'}}</view>
      <button wx:if="{{cursor}}" bindtap="more">再加载50条</button>
    </block>
    <view wx:if="{{view === 'record' && record}}" class="v2-card">
      <view class="v2-title">{{record.data.classLabel}}</view><view>{{record.data.memberName}} · {{record.data.date}}</view><view>{{record.data.course.name}}</view>
      <view wx:for="{{recordFields}}" wx:key="label">{{item.label}}：{{item.value}}</view>
      <view>旷课名单：{{record.data.absentNames}}</view><view>请假名单：{{record.data.leaveNames}}</view><view>班风评价：{{record.data.evaluation}}</view><view>异常与反馈：{{record.data.feedback}}</view><view>教师建议：{{record.data.suggestion}}</view><view>其他情况：{{record.data.otherDescription}}</view>
      <view>首次提交：{{record.data.firstSubmittedAt}}</view><view wx:if="{{record.data.correctedAt}}">最近更正：{{record.data.correctedAt}} · {{record.data.reason}}</view>
      <view class="v2-photos"><image wx:for="{{photoUrls}}" wx:key="*this" src="{{item}}" mode="aspectFill" data-url="{{item}}" bindtap="previewPhoto"/></view>
      <button wx:if="{{canEdit}}" bindtap="editRecord">更正记录（须说明原因）</button><view wx:else class="v2-note">本人编辑期限为首次提交后不足24小时，超时请联系管理员纠错。</view>
      <button bindtap="history">{{versions.length ? (versionCursor ? '加载更多修改历史' : '查看修改历史') : '查看修改历史'}}</button>
      <view wx:for="{{versions}}" wx:key="id" class="v2-row"><view>{{item.detail}}</view><view>{{item.data.correctedAt || item.data.firstSubmittedAt}} · {{item.data.reason}}</view><view wx:for="{{item.historyFields}}" wx:for-item="metric" wx:key="label">{{metric.label}}：{{metric.value}}</view><view>旷课：{{item.data.absentNames}}；请假：{{item.data.leaveNames}}</view><view>班风：{{item.data.evaluation}}；反馈：{{item.data.feedback}}；建议：{{item.data.suggestion}}；其他：{{item.data.otherDescription}}</view><view>修改人：{{item.data.actorId}} · 版本 {{item.data.recordVersion}}</view><button size="mini" data-id="{{item.id}}" bindtap="versionPhotos">查看该版本照片</button></view>
    </view>
    <view wx:if="{{view === 'manage' && admin && section === 'audit'}}" class="v2-card"><view class="v2-title">换届业务清空</view><view>清空所有年份的业务资料，保留全部管理员及其绑定班级，管理员启停状态不变。</view><button type="warn" disabled="{{busy}}" bindtap="clearBusiness">预览清空范围</button><view>{{clearProgress}}</view></view>
  </block>
  <view wx:if="{{formType}}" class="v2-card v2-form">
    <view class="v2-title">{{formTitle}}</view>
    <view wx:for="{{fields}}" wx:key="key" wx:for-item="field" class="v2-field">
      <view class="v2-label">{{field.label}}</view>
      <textarea wx:if="{{field.kind === 'textarea'}}" value="{{field.value}}" data-key="{{field.key}}" bindinput="input" maxlength="-1"/>
      <picker wx:elif="{{field.kind === 'date'}}" mode="date" value="{{field.value}}" data-key="{{field.key}}" bindchange="input"><view class="v2-picker">{{field.value || '选择日期'}} ▾</view></picker>
      <picker wx:elif="{{field.kind === 'select'}}" range="{{field.options}}" range-key="label" value="{{field.value}}" data-key="{{field.key}}" bindchange="input"><view class="v2-picker">{{field.options[field.value].label || '暂无可选项'}} ▾</view></picker>
      <checkbox-group wx:elif="{{field.kind === 'multi'}}" data-key="{{field.key}}" bindchange="multi"><label wx:for="{{field.options}}" wx:key="value" class="v2-choice"><checkbox value="{{item.value}}" checked="{{item.checked}}"/>{{item.label}}</label></checkbox-group>
      <input wx:else value="{{field.value}}" type="{{field.kind === 'number' ? 'number' : 'text'}}" data-key="{{field.key}}" bindinput="input" maxlength="500"/>
    </view>
    <block wx:if="{{formType === 'recordSubmit' || formType === 'recordEdit'}}"><view class="v2-label">清晰签字表照片（1–3张，历史版本照片继续保留）</view><view class="v2-photos"><view wx:for="{{formPhotos}}" wx:key="*this"><image src="{{item}}" mode="aspectFill"/><button size="mini" data-index="{{index}}" bindtap="removePhoto">移除</button></view></view><button disabled="{{busy}}" bindtap="choosePhotos">添加照片</button><button wx:if="{{formType === 'recordSubmit'}}" bindtap="saveDraft">保存本机文字草稿</button></block>
    <view class="v2-actions"><button type="primary" disabled="{{busy}}" bindtap="saveForm">{{formType === 'taskAdjust' ? '生成待确认草稿' : '保存'}} </button><button disabled="{{busy}}" bindtap="cancelForm">取消</button></view>
  </view>
</view>
