<view class="home-page">
  <view class="home-heading">
    <view class="home-welcome">
      <text class="home-greeting">{{memberName}}，你好</text>
      <text class="home-role">{{roleLabel}}</text>
    </view>
  </view>

  <view class="week-card">
    <view class="week-copy">
      <view class="week-semester">{{semesterName}}</view>
      <view wx:if="{{semesterId}}" class="week-number">第 <text class="week-digits">{{week}}</text> 周</view>
      <view class="week-range">{{semesterId ? dates : "建立真实学期后显示周次与听课安排"}}</view>
      <view class="week-mode"><view class="week-mode-dot"></view><text>{{modeLabel}}</text></view>
    </view>
    <view class="week-art" aria-hidden="true">
      <view class="art-sheet art-sheet-back"></view>
      <view class="art-sheet art-sheet-front">
        <view class="art-binding binding-left"></view>
        <view class="art-binding binding-right"></view>
        <view class="art-header"></view>
        <view class="art-grid">
          <view class="art-cell"></view><view class="art-cell"></view><view class="art-cell"></view>
          <view class="art-cell"></view><view class="art-cell art-cell-check"><view class="art-tick"></view></view><view class="art-cell"></view>
        </view>
      </view>
      <view class="art-spark spark-one"></view><view class="art-spark spark-two"></view>
    </view>
  </view>

  <view wx:if="{{!activeSemesterId && admin}}" class="notice">尚未启用学期<view class="link" data-target="manage" bindtap="navigate">进入管理工作台准备新学期 ›</view></view>
  <view class="availability-card" hover-class="home-pressed" data-target="availability" bindtap="navigate" role="button" aria-label="填写或调整无课时间">
    <view class="availability-icon" aria-hidden="true"><view class="time-dial"><view class="time-hand"></view></view></view>
    <view class="availability-copy">
      <view class="availability-heading">无课时间<text wx:if="{{availabilityReady}}" class="availability-saved">已填写</text></view>
    </view>
    <view class="home-chevron" aria-hidden="true"></view>
  </view>

  <view class="home-section-heading">
    <view class="home-section-title">我的本周任务</view>
    <view class="home-section-link" hover-class="home-pressed" data-target="schedule" data-week="{{week}}" bindtap="navigate" role="button">全部安排<view class="home-chevron"></view></view>
  </view>
  <view wx:for="{{homeTasks}}" wx:for-item="homeTask" wx:key="id" class="home-task">
    <view class="task-topline">
      <view class="task-class">{{homeTask.classLabel}}</view>
      <view class="task-status {{homeTask.done ? 'task-status-done' : ''}}"><view class="task-status-dot"></view>{{homeTask.done ? '已提交' : homeTask.status === 'pendingAdjustment' ? '待调整' : '待完成'}}</view>
    </view>
    <view class="task-course">{{homeTask.course.name}}</view>
    <view class="task-detail"><text class="task-detail-label">时间</text><text class="task-detail-value">{{homeTask.timeLabel}}</text></view>
    <view class="task-detail"><text class="task-detail-label">地点</text><text class="task-detail-value">{{homeTask.course.classroom}}</text></view>
    <view class="task-detail"><text class="task-detail-label">教师</text><text class="task-detail-value">{{homeTask.course.teacher}}</text></view>
    <view wx:for="{{homeTask.courseCounts}}" wx:for-item="count" wx:key="id" class="course-meta">
      <view wx:if="{{homeTask.courseCounts.length > 1}}">{{count.label}}</view>
      <view>课表人数：{{count.count}}{{count.combined ? '（合班合计）' : ''}}</view>
    </view>
    <view class="task-bottom">
      <text class="task-hint">{{homeTask.done ? '本次听课已记录' : '听课后记得上传签字表'}}</text>
      <button wx:if="{{homeTask.status === 'confirmed'}}" class="task-button" hover-class="home-pressed" data-id="{{homeTask.id}}" bindtap="open">填写记录<text class="button-arrow">→</text></button>
      <button wx:elif="{{homeTask.done && homeTask.recordId}}" class="task-button task-button-done" hover-class="home-pressed" data-id="{{homeTask.recordId}}" data-target="record" bindtap="open">查看记录<text class="button-arrow">→</text></button>
      <text wx:elif="{{homeTask.status === 'pendingAdjustment'}}" class="task-hint">课表待调整，暂不能填写</text>
      <text wx:else class="task-hint">记录信息暂不可用，请下拉刷新</text>
    </view>
  </view>
  <view wx:if="{{!homeTasks.length}}" class="home-empty">
    <view class="empty-paper" aria-hidden="true">
      <view class="empty-paper-line"></view><view class="empty-paper-line short-line"></view>
      <view class="empty-paper-badge"><view class="empty-check"></view></view>
    </view>
    <view class="home-empty-title">{{skipped ? '本周已跳过听课' : '本周暂无个人任务'}}</view>
    <view class="home-empty-description">{{skipped ? '本周无需听课，后续安排请留意周次更新' : '先填好无课时间，安排确认后会显示在这里'}}</view>
  </view>

  <block wx:if="{{semesterId}}">
    <view class="home-section-heading"><view class="home-section-title">我的下周任务</view><view wx:if="{{nextWeek <= maxWeek}}" class="muted small">第 {{nextWeek}} 周</view></view>
    <view wx:for="{{homeNextTasks}}" wx:for-item="nextTask" wx:key="id" class="home-task">
      <view class="task-topline">
        <view class="task-class">{{nextTask.classLabel}}</view>
        <view class="task-status {{nextTask.done ? 'task-status-done' : ''}}"><view class="task-status-dot"></view>{{nextTask.done ? '已提交' : nextTask.status === 'pendingAdjustment' ? '待调整' : '待完成'}}</view>
      </view>
      <view class="task-course">{{nextTask.course.name}}</view>
      <view class="task-detail"><text class="task-detail-label">时间</text><text class="task-detail-value">{{nextTask.timeLabel}}</text></view>
      <view class="task-detail"><text class="task-detail-label">地点</text><text class="task-detail-value">{{nextTask.course.classroom}}</text></view>
      <view class="task-detail"><text class="task-detail-label">教师</text><text class="task-detail-value">{{nextTask.course.teacher}}</text></view>
      <view wx:for="{{nextTask.courseCounts}}" wx:for-item="count" wx:key="id" class="course-meta">
        <view wx:if="{{nextTask.courseCounts.length > 1}}">{{count.label}}</view>
        <view>课表人数：{{count.count}}{{count.combined ? '（合班合计）' : ''}}</view>
      </view>
      <view class="task-bottom">
        <text class="task-hint">{{nextTask.done ? '本次听课已记录' : '听课后记得上传签字表'}}</text>
        <button wx:if="{{nextTask.status === 'confirmed'}}" class="task-button" hover-class="home-pressed" data-id="{{nextTask.id}}" bindtap="open">填写记录<text class="button-arrow">→</text></button>
        <button wx:elif="{{nextTask.done && nextTask.recordId}}" class="task-button task-button-done" hover-class="home-pressed" data-id="{{nextTask.recordId}}" data-target="record" bindtap="open">查看记录<text class="button-arrow">→</text></button>
        <text wx:elif="{{nextTask.status === 'pendingAdjustment'}}" class="task-hint">课表待调整，暂不能填写</text>
        <text wx:else class="task-hint">记录信息暂不可用，请下拉刷新</text>
      </view>
    </view>
    <view wx:if="{{nextWeekLoading}}" class="home-empty-description">正在加载下周任务…</view>
    <view wx:elif="{{nextWeekError}}" class="v2-load-error" bindtap="loadNextWeek" role="button">{{nextWeekError}} · 点击重试</view>
    <view wx:elif="{{!homeNextTasks.length}}" class="home-empty-description">{{nextWeekMessage}}</view>
  </block>

  <block wx:if="{{manager}}">
    <view class="home-section-heading">
      <view class="home-section-title">全组本周进度</view>
      <view class="home-section-link" hover-class="home-pressed" data-target="reports" bindtap="navigate" role="button">查看汇总<view class="home-chevron"></view></view>
    </view>
    <view class="home-overview">
      <view class="overview-stat"><view class="overview-number">{{taskCount}}<text class="overview-unit">项</text></view><view class="overview-label">已安排任务</view></view>
      <view class="overview-stat"><view class="overview-number overview-blue">{{recordCount}}<text class="overview-unit">份</text></view><view class="overview-label">已提交记录</view></view>
      <view class="overview-stat"><view class="overview-number">{{coverage}}<text class="overview-unit">个</text></view><view class="overview-label">已覆盖教学班</view></view>
    </view>
  </block>

  <view class="home-footer">{{cloudMode ? modeLabel + ' · 下拉刷新同步最新数据' : '本地体验版 · 示例人物与课程均为虚构'}}<view wx:if="{{!cloudMode}}">数据仅保存在当前设备，不跨设备同步</view></view>
</view>
