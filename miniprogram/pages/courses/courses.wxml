<block wx:if="{{cloudMode}}"><include src="../../templates/cloud.wxml" /></block>
<block wx:else>
<view class="page"><view class="eyebrow">COURSE DIRECTORY</view><view class="title">课程总表</view><view class="subtitle">{{semesterName}} · 共 {{count}} 个上课时段</view>
 <view class="search"><view class="search-symbol"></view><input placeholder="搜索课程、班级或教师" value="{{search}}" bindinput="search"/></view>
 <view class="filters"><view wx:for="{{grades}}" wx:key="*this" class="chip {{grade === item ? 'active' : ''}}" data-grade="{{item}}" bindtap="grade">{{item}}{{item === '全部' ? '' : '级'}}</view></view>
 <view wx:for="{{courses}}" wx:key="id" class="card" data-id="{{item.id}}" bindtap="details"><view class="row between"><text class="pill">{{item.classLabel}}</text><text class="muted small">{{item.nature}}</text></view><view class="course-title">{{item.name}}</view><view class="course-meta">{{item.teacher}} · {{item.expected}} 人</view><view class="divider"></view><view class="row between"><text class="course-meta">{{item.timeLabel}}</text><text class="chevron">›</text></view><view class="course-meta">{{item.classroom}}</view></view>
 <view wx:if="{{!courses.length}}" class="empty"><view class="empty-title">没有找到课程</view><view class="muted">试试其他关键词或年级。</view></view><view class="footer-note">课程与上课时段按学期保存</view></view>

</block>
