<block wx:if="{{cloudMode}}"><include src="../../templates/cloud.wxml" /></block>
<block wx:else>
<view class="page"><view class="eyebrow">WEEKLY REPORTS</view><view class="title">每一份记录，都算数</view>
 <view class="week-switch"><view class="week-arrow" data-delta="-1" bindtap="move">‹</view><view class="week-center"><view class="week-title">第 {{week}} 周</view><view class="week-dates">{{dates}}</view></view><view class="week-arrow" data-delta="1" bindtap="move">›</view></view>
 <view class="card"><view class="row between"><view class="section-title">{{skipped ? '本周已跳过' : '本周提交进度'}}</view><view><text class="number" style="font-size:36rpx">{{submitted}}</text><text class="muted"> / {{total}}</text></view></view><view class="progress"><view class="progress-fill" style="width:{{progress}}%"></view></view><view class="muted small" style="margin-top:16rpx">{{skipped ? '本周不生成漏交或零出勤统计' : '已提交记录 / 正式安排任务'}}</view></view>
 <view class="tabs"><view class="tab {{tab === 'all' ? 'active' : ''}}" data-tab="all" bindtap="tab">听课汇总</view><view class="tab {{tab === 'mine' ? 'active' : ''}}" data-tab="mine" bindtap="tab">个人听课</view><view class="tab {{tab === 'stats' ? 'active' : ''}}" data-tab="stats" bindtap="tab">周统计</view></view>
 <block wx:if="{{tab !== 'stats'}}"><view wx:for="{{records}}" wx:key="id" class="card"><view class="row between"><view><text style="font-weight:600">{{item.name}}</text> <text class="pill green">已提交</text></view><text class="muted small">{{item.date}}</text></view><view class="course-title">{{item.course}}</view><view class="row between"><text class="muted">{{item.classLabel}}</text><text wx:if="{{item.canView}}" class="link" data-id="{{item.id}}" bindtap="detail">查看记录 ›</text><text wx:else class="muted small">仅公开汇总条目</text></view></view><view wx:if="{{!records.length}}" class="empty"><view class="empty-icon">▤</view><view class="empty-title">记录正在路上</view><view class="muted">成员提交后，会自动出现在本周汇总。</view></view></block>
 <block wx:else><view wx:for="{{stats}}" wx:key="grade" class="card"><view class="row between"><text class="section-title">{{item.grade}} 级</text><text class="link">{{item.rate}}</text></view><view class="progress"><view class="progress-fill" style="width:{{item.width}}%"></view></view><view class="muted small" style="margin-top:18rpx">{{item.count}} 份记录 · {{item.valid}} 份可计算出勤率</view></view><view class="notice">出勤率按有效听课记录的实到总人次 ÷ 对应应到总人次计算。缺失记录不按 0 处理，仅代表已观察课堂。</view></block>
 <view wx:if="{{canExportExcel || canExportNames}}" class="card"><view class="section-title">本周汇总导出</view><view class="muted small" style="margin-top:10rpx">名单与原始数据分开导出，年级和班级随学期变化。</view><view class="actions"><button wx:if="{{canExportNames}}" class="secondary" data-kind="txt" bindtap="export" disabled="{{busy}}">名单 TXT</button><button wx:if="{{canExportExcel}}" class="primary" data-kind="xlsx" bindtap="export" disabled="{{busy}}">汇总 Excel</button></view><view wx:if="{{canExportNames}}" class="link small" style="text-align:center;margin-top:24rpx" bindtap="copy">直接复制请假 / 旷课名单</view><view wx:if="{{filePath}}" class="notice" bindtap="open">{{filename}}<view class="link">已保存 · 点击打开 / 分享 ›</view></view></view></view>

</block>
