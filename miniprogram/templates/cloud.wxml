<view class="v2-page {{view === 'home' ? 'v2-home' : view === 'profile' ? 'v2-profile' : ''}}">
  <block wx:if="{{loadingInitial}}"><include src="cloud-skeleton.wxml" /></block>
  <view wx:elif="{{!hasLoaded && error}}" class="v2-load-error" bindtap="refreshWeek" role="button">加载失败，点击重试</view>
  <block wx:else>
  <block wx:if="{{view !== 'home' && view !== 'profile'}}"><view class="eyebrow">{{eyebrow}}</view><view class="title">{{view === 'records' ? '每一份记录，都算数' : view === 'availability' ? '把空闲留给好学风' : title}}</view></block>
  <view wx:if="{{error}}" class="v2-load-error" bindtap="refreshWeek" role="button">加载失败，点击重试</view>
  <view wx:if="{{refreshing}}" class="v2-refresh-note">更新中…</view>
  <view wx:if="{{reviewMode}}" class="notice">审核样例体验：此处是隔离的模拟资料，所选照片只显示样例图，不保存原图。</view>
  <view wx:if="{{busy && !refreshing}}" class="v2-note">正在处理，请稍候…</view>
  <view wx:if="{{maintenance}}" class="v2-card">
    <view class="v2-title">业务数据维护中</view><view>写入已冻结，管理员可在清空入口继续处理同一任务。</view>
    <button wx:if="{{admin}}" type="warn" disabled="{{busy}}" bindtap="clearBusiness">继续业务清空</button>
  </view>
  <view wx:elif="{{!memberId}}" class="v2-card">
    <view class="v2-title">{{status === 'needsAdministrator' ? '首次安装' : status === 'preparing' ? '组织正在准备新学期' : '加入学风督察小组'}}</view>
    <block wx:if="{{status === 'needsAdministrator'}}">
      <view>{{canInitialize ? '请填写真实学期、本人班级及本人资料，一次完成首位管理员登记。' : '请等待指定的初始化微信完成登记。'}}</view>
      <button wx:if="{{canInitialize}}" type="primary" data-type="initialize" bindtap="newForm">首次登记</button>
    </block>
    <view wx:elif="{{removed}}">成员资格已停用，请联系管理员核实并恢复。</view>
    <block wx:elif="{{status === 'ready'}}">
      <view wx:for="{{rows}}" wx:key="id">本人申请：{{item.label}} · {{item.status === 'pending' ? '待审核' : item.status === 'rejected' ? '已驳回' : item.status}} {{item.detail}}</view>
      <button data-type="join" bindtap="newForm">填写／重新提交入组申请</button>
      <button data-type="rebindRequest" bindtap="newForm">原成员申请微信换绑</button>
      <view class="v2-note">换绑须经管理员线下核实，姓名和学号不能用于自行认领账号。</view>
      <view class="link" data-target="review" bindtap="navigate">微信审核账号体验 ›</view>
    </block>
  </view>
  <block wx:elif="{{!maintenance}}">
    <view wx:if="{{!activeSemesterId && view !== 'home' && view !== 'profile'}}" class="notice">尚未启用学期。{{admin ? '请先建立学期并配置真实课表。' : '请等待管理员完成新学期准备。'}}<view wx:if="{{admin && view !== 'manage'}}" class="link" data-target="manage" bindtap="navigate">进入管理工作台 ›</view></view>
    <block wx:if="{{view === 'home'}}"><include src="cloud-home.wxml" /></block>
    <block wx:if="{{view === 'profile'}}"><include src="cloud-profile.wxml" /></block>
    <view wx:if="{{semesters.length && view !== 'home' && view !== 'profile' && view !== 'join' && view !== 'record' && view !== 'submission'}}" class="v2-card {{view === 'records' ? 'v2-semester-compact' : ''}}">
      <view class="v2-label">{{view === 'records' ? '查看学期' : view === 'home' || view === 'availability' ? '组织当前学期' : '查看学期（仅影响本机）'}}</view>
      <picker wx:if="{{view !== 'home' && view !== 'availability'}}" range="{{semesterOptions}}" range-key="label" value="{{semesterIndex}}" bindchange="chooseSemester"><view class="v2-picker">{{semesterName}} ▾</view></picker>
      <view wx:else>{{semesterName}}</view>
      <button wx:if="{{semesterCursor}}" size="mini" bindtap="moreSemesters">加载更早学期</button>
    </view>
    <view wx:if="{{view === 'schedule' || view === 'records' && semesterId || view === 'availability'}}" class="week-switch"><view class="week-arrow" data-delta="-1" bindtap="moveWeek">‹</view><view class="week-center"><view class="week-title">{{semesterId ? '第 ' + week + ' 周' : '尚未启用学期'}}</view><view class="week-dates">{{dates}}</view></view><view class="week-arrow" data-delta="1" bindtap="moveWeek">›</view></view>
    <view wx:if="{{view === 'schedule'}}" class="row" style="justify-content:flex-end;margin-top:22rpx"><text class="link" data-target="courses" bindtap="navigate">课程总表 ›</text></view>
    <block wx:if="{{view === 'schedule'}}">
      <view wx:if="{{manager && semesterId}}" class="card"><view class="section-title">排班工作台</view><view class="subtitle small">非本班 · 每人至多一次 · 人工确认后生效</view><view class="v2-actions"><button disabled="{{busy}}" bindtap="generate">{{weekData.plan || weekData.draft ? "重新生成草稿" : "生成排班草稿"}}</button><button disabled="{{busy}}" bindtap="adjust">补排任务</button><button wx:if="{{admin}}" disabled="{{busy}}" bindtap="skipWeek">跳过本周</button></view></view>
      <view wx:if="{{weekData.draft}}" class="v2-card">
        <view class="v2-title">待人工确认的调整草稿</view><view class="notice warn">草稿尚未生效{{weekData.plan ? "，原正式安排仍保留" : ""}}。请核对后手动确认。</view><view>{{weekData.draft.data.reason}}</view>
        <view wx:for="{{tasks}}" wx:key="id" wx:if="{{item.status === 'draft' && item.parentId === weekData.draft.id}}" class="v2-row"><view>{{item.label}}</view><view>{{item.detail}}</view><view>{{item.cancel ? '取消原任务' : '拟安排'}}{{item.replaces ? '（替换原任务）' : ''}}</view></view>
        <view wx:for="{{weekData.uncovered}}" wx:key="label">未覆盖：{{item.label}} · {{item.reason}}</view>
        <button wx:if="{{manager}}" disabled="{{busy}}" type="primary" bindtap="confirmPlan">确认后生效</button>
      </view>
      <view wx:if="{{weekData.plan.data.status === 'skipped'}}" class="v2-note">本周已跳过：{{weekData.plan.data.reason}}</view><view class="search"><view class="search-symbol"></view><input placeholder="搜索本周姓名、班级或课程" value="{{searchText}}" bindinput="search"/></view><view class="row between"><view class="v2-title">正式任务 · {{visibleTasks.length}}</view><text class="link" data-target="availability" bindtap="navigate">填写第 {{week}} 周无课时间 ›</text></view>
      <view wx:for="{{visibleTasks}}" wx:key="id" class="v2-card">
        <view class="row between"><view class="section-title">{{item.label}}</view><text wx:if="{{item.status}}" class="pill {{item.status === 'submitted' || item.status === 'approved' ? 'green' : 'gray'}}">{{item.statusLabel}}</text></view><view wx:if="{{item.data.course.name}}" class="course-title">{{item.data.course.name}}</view><view class="course-meta">{{item.detail}}</view><view>{{item.status === 'pendingAdjustment' ? '待调整：原课表已失效，暂不能提交' : item.status === 'submitted' ? '已提交' : '已确认'}}</view>
        <button wx:if="{{item.status === 'confirmed' && item.memberId === memberId}}" data-id="{{item.id}}" bindtap="open">填写听课记录</button>
        <button wx:if="{{manager && item.status !== 'submitted'}}" data-id="{{item.id}}" bindtap="adjust">转派／取消</button>
      </view>
      <view wx:if="{{manager && !weekData.draft && weekData.plan.data.uncovered.length}}" class="card"><view class="section-title">未覆盖教学班</view><view wx:for="{{weekData.plan.data.uncovered}}" wx:key="label" class="v2-row">{{item.label}} · {{item.reason}}</view></view>
      <view wx:if="{{!visibleTasks.length && !busy}}" class="empty"><view class="empty-icon">▦</view><view class="empty-title">{{searchText ? "没有匹配任务" : weekData.draft ? "请先确认草稿" : weekData.plan ? "本周暂无正式任务" : "本周安排尚未发布"}}</view><view class="muted">{{semesterId ? "填写无课时间，等待管理人员确认。" : "启用学期后，在这里查看每周安排。"}}</view></view>
    </block>
    <view wx:if="{{view === 'availability' && semesterId}}" class="v2-card">
      <view class="v2-title">勾选完整可听课时间</view>
      <view class="v2-save-toolbar"><view class="muted small">{{dirty ? "有未保存修改" : availabilityReady ? "本周无课时间已保存" : "尚未提交本周无课时间"}}</view><view class="v2-actions"><button wx:if="{{week > 1}}" disabled="{{busy}}" bindtap="copyAvailability">复制上一周</button><button type="primary" disabled="{{busy}}" bindtap="saveAvailability">确认保存第 {{week}} 周</button></view></view>
      <label wx:if="{{role !== 'member'}}"><switch checked="{{optedIn}}" disabled="{{busy}}" bindchange="optIn"/>第 {{week}} 周我也听课</label>
      <view class="muted small">点击星期可整列切换 · 已选 {{selectedSlots.length}} 节</view>
      <view class="grid-row"><view class="grid-label"></view><view wx:for="{{availabilityDays}}" wx:key="n" class="day-head" data-day="{{item.n}}" bindtap="toggleDay">{{item.name}}</view></view>
      <view wx:for="{{availabilityRows}}" wx:for-item="row" wx:key="n" class="grid-row"><view class="grid-label">{{row.n}}</view><view wx:for="{{row.cells}}" wx:key="key" class="time-cell {{item.selected ? 'selected' : ''}}" data-key="{{item.key}}" bindtap="toggleSlot">{{item.selected ? '✓' : ''}}</view></view>
      <view class="row gap grid-legend"><view class="legend-square"></view><text>可听课</text><view class="legend-square off"></view><text>不可安排</text></view>
      <textarea placeholder="备注" value="{{availabilityNote}}" bindinput="availabilityNote"/>
    </view>
    <view wx:if="{{view === 'manage'}}" class="filters"><view wx:for="{{sections}}" wx:key="id" wx:if="{{admin || (item.id !== 'classes' && item.id !== 'semesters' && item.id !== 'courses' && item.id !== 'rebindings' && item.id !== 'autoApproved')}}" class="chip {{section === item.id ? 'active' : ''}}" data-id="{{item.id}}" bindtap="section">{{item.label}}</view></view>
    <view wx:if="{{view === 'manage' && admin && (section === 'applications' || section === 'autoApproved')}}" class="v2-card">
      <view class="v2-title">自动通过新申请</view><switch checked="{{autoApprovalActive}}" disabled="{{busy || formType === 'autoApprovalSet'}}" bindchange="toggleAutoApproval"/>
      <view>{{autoApprovalActive ? '已开启' : autoApprovalExpired ? '已到期，自动关闭' : '已关闭'}}</view><view wx:if="{{autoApprovalDeadline}}">截止：{{autoApprovalDeadline}}</view>
      <view>最近设置：{{autoApprovalUpdated}}</view><view class="v2-note">开启须设置截止时间。有效期内的新申请经服务端校验后成为普通成员；到时或提前关闭均恢复人工审核，不移除已通过成员。已有待审核申请仍需人工处理。</view>
      <button wx:if="{{autoApprovalActive}}" data-type="autoApprovalSet" bindtap="newForm">修改截止时间</button><button wx:if="{{section !== 'autoApproved'}}" data-id="autoApproved" bindtap="section">查看自动通过人员</button>
    </view>
    <view wx:if="{{view === 'manage' && section === 'applications'}}" class="tabs"><view class="tab {{applicationFilter === 'pending' ? 'active' : ''}}" data-id="pending" bindtap="applicationFilter">待审核</view><view class="tab {{applicationFilter === 'all' ? 'active' : ''}}" data-id="all" bindtap="applicationFilter">全部申请</view></view>
    <view wx:if="{{view === 'manage' || view === 'courses'}}" class="search"><view class="search-symbol"></view><input placeholder="{{view === 'courses' || section === 'courses' ? '搜索已加载的课程、班级或教师' : '搜索已加载的姓名、学号、班级或课程'}}" value="{{searchText}}" bindinput="search"/></view>
    <block wx:if="{{view === 'courses' || view === 'manage' && section === 'courses'}}"><view class="muted small">已加载 {{rows.length}} 个课程时段 · 当前筛选 {{visibleRows.length}} 个</view><view class="filters"><view class="chip {{courseGrade === '全部' ? 'active' : ''}}" data-grade="全部" bindtap="filterCourseGrade">全部年级</view><view wx:for="{{courseGrades}}" wx:key="*this" class="chip {{courseGrade === item ? 'active' : ''}}" data-grade="{{item}}" bindtap="filterCourseGrade">{{item}}级</view></view><view wx:if="{{courseClassesIncomplete}}" class="muted small">部分课程班级资料未加载，班级搜索和年级筛选尚不完整。</view><button wx:if="{{courseClassCursor}}" disabled="{{busy}}" bindtap="moreCourseClasses">再加载50条班级资料</button></block>
    <view wx:if="{{view === 'manage' && section === 'applications'}}" class="v2-card"><view>已选 {{selectedApplications.length}} 人（仅当前筛选结果）</view><view class="v2-actions"><button size="mini" bindtap="selectAllApplications">选择当前结果／取消全选</button><button size="mini" data-action="approve" disabled="{{busy || !selectedApplications.length}}" bindtap="reviewApplications">批量通过</button><button size="mini" data-action="reject" disabled="{{busy || !selectedApplications.length}}" bindtap="reviewApplications">批量驳回</button></view></view>
    <view wx:if="{{admin && view === 'manage'}}" class="v2-actions">
      <button wx:if="{{section === 'classes'}}" data-type="classSave" bindtap="newForm">独立新增班级</button>
      <button wx:if="{{section === 'semesters'}}" data-type="semesterCreate" bindtap="newForm">新建学期草稿</button>
      <block wx:if="{{section === 'courses' && semesterId}}"><button data-type="courseSave" bindtap="newForm">新增课程</button><button data-type="import" bindtap="newForm">JSON课表导入</button></block>
    </view>
    <block wx:if="{{view === 'manage'}}"><include src="cloud-form.wxml" /></block>
    <view wx:if="{{view === 'manage' && admin && section === 'audit' && !reviewMode}}" class="v2-card"><view class="v2-title">换届业务清空</view><view>清空所有年份的业务资料，保留全部管理员及其绑定班级，管理员启停状态不变。</view><button type="warn" disabled="{{busy}}" bindtap="clearBusiness">预览清空范围</button><view>{{clearProgress}}</view></view>
    <block wx:if="{{view === 'records' && semesterId}}">
      <view class="card v2-record-progress"><view class="row between"><view class="section-title">{{skipped ? '本周已跳过' : '本周提交进度'}}</view><view><text class="number" style="font-size:36rpx">{{weekSubmitted}}</text><text class="muted"> / {{weekTotal}}</text></view></view><view class="progress"><view class="progress-fill" style="width:{{weekProgress}}%"></view></view><view class="muted small" style="margin-top:16rpx">{{skipped ? '本周不计漏交或零出勤统计' : '已提交记录 / 正式安排任务'}}</view></view>
      <view class="tabs"><view wx:if="{{manager}}" class="tab {{recordTab === 'all' ? 'active' : ''}}" data-id="all" bindtap="recordTab">听课汇总</view><view class="tab {{recordTab === 'mine' ? 'active' : ''}}" data-id="mine" bindtap="recordTab">个人听课</view><view wx:if="{{manager}}" class="tab {{recordTab === 'stats' ? 'active' : ''}}" data-id="stats" bindtap="recordTab">周统计</view></view>
    </block>
    <view wx:if="{{view === 'records' && recordTab === 'stats' && semesterId && statsLoaded}}" class="v2-card"><view class="v2-title">本周最新记录统计</view><view>已提交 {{statsCount}} 份记录；出勤率按有效应到、实到人次加权。</view><block wx:if="{{statsCount > 0}}"><view wx:for="{{stats}}" wx:key="grade" class="v2-row">{{item.grade}}级：观测 {{item.count}} 次，有效 {{item.valid}} 次，出勤率 {{item.rate}}</view></block><view wx:else class="v2-note">{{skipped ? '本周已跳过，没有新的听课统计。' : '本周尚无可统计的已提交记录。'}}</view><view class="v2-note">统计仅代表实际听课观测；更正后重新查看或导出即可使用最新数据。</view></view>
    <view wx:if="{{impacts.length}}" class="v2-card"><view class="v2-title">以下任务已标记待调整</view><view>已生成调整草稿，请前往“听课安排”选择相应学期与周次核对并确认。确认前原任务不能提交，已完成任务保持不变。</view><view wx:for="{{impacts}}" wx:key="id" class="v2-row">第 {{item.week}} 周 · {{item.label}} · {{item.detail}}</view></view>
    <block wx:if="{{view === 'manage' || (view === 'records' && recordTab !== 'stats') || view === 'courses'}}">
      <view wx:for="{{visibleRows}}" wx:key="id" class="v2-card {{view === 'records' ? 'v2-record-card' : ''}}">
        <block wx:if="{{view === 'records'}}"><view class="row between v2-record-head"><view class="row gap"><text class="section-title">{{item.data.memberName || item.label}}</text><text class="pill green">已提交</text></view><text class="muted small">{{item.data.date || item.date}}</text></view><view class="course-title">{{item.data.course.name}}</view><view class="row between v2-record-footer"><text class="muted small v2-record-meta">{{item.data.classLabel}} · 第 {{item.data.course.start}}–{{item.data.course.end}} 节<text wx:if="{{item.data.course.classroom}}"> · {{item.data.course.classroom}}</text></text><text class="link small v2-record-link" data-id="{{item.id}}" bindtap="open">查看记录与照片 ›</text></view></block>
        <block wx:else><view class="row between"><view class="section-title">{{item.label}}</view><text wx:if="{{item.status}}" class="pill {{item.status === 'submitted' || item.status === 'approved' ? 'green' : 'gray'}}">{{item.statusLabel}}</text></view><view wx:if="{{item.data.course.name}}" class="course-title">{{item.data.course.name}}</view><view class="course-meta">{{item.detail}}</view>
        <view wx:if="{{section === 'members'}}">{{item.role === 'admin' ? '管理员' : item.role === 'leader' ? '组部长' : '成员'}} · {{item.active ? '有效' : '已停用'}}</view>
        <view wx:if="{{item.status}}">{{item.statusLabel}}</view>
        <button wx:if="{{view === 'courses' || view === 'manage' && section === 'courses'}}" data-id="{{item.id}}" bindtap="courseDetails">课程详情与有效周次</button>
        <view wx:if="{{view === 'manage'}}" class="v2-actions">
          <block wx:if="{{section === 'members'}}">
            <block wx:if="{{admin && item.active}}"><button wx:if="{{item.role !== 'admin'}}" size="mini" data-id="{{item.id}}" data-action="admin" bindtap="rowAction">授予管理员</button><button wx:if="{{item.role !== 'member'}}" size="mini" data-id="{{item.id}}" data-action="member" bindtap="rowAction">降为成员</button><button wx:if="{{item.role === 'member'}}" size="mini" data-id="{{item.id}}" data-action="leader" bindtap="rowAction">设为组部长</button></block>
            <button wx:if="{{item.active && (admin || item.role === 'member')}}" size="mini" data-id="{{item.id}}" data-action="remove" bindtap="rowAction">停用</button>
            <button wx:if="{{admin && !item.active}}" size="mini" data-id="{{item.id}}" data-action="restore" bindtap="rowAction">恢复资格</button>
          </block>
          <block wx:if="{{section === 'applications' && item.status === 'pending'}}"><button size="mini" data-id="{{item.id}}" bindtap="selectApplication">{{item.selected ? '已选择 ✓' : '选择'}}</button><button size="mini" data-id="{{item.id}}" data-action="approve" bindtap="rowAction">通过</button><button size="mini" data-id="{{item.id}}" data-action="reject" bindtap="rowAction">驳回</button></block>
          <button wx:if="{{section === 'rebindings' && admin && item.status === 'pending'}}" data-id="{{item.id}}" data-action="rebind" bindtap="rowAction">线下核实后确认换绑</button>
          <block wx:if="{{admin && (section === 'classes' || section === 'courses')}}"><button size="mini" data-id="{{item.id}}" bindtap="edit">编辑</button><button wx:if="{{section === 'classes' || item.active}}" size="mini" data-id="{{item.id}}" data-action="{{item.active ? 'disable' : 'enable'}}" bindtap="rowAction">{{item.active ? '停用' : '启用'}}</button><button wx:if="{{section === 'courses'}}" size="mini" data-id="{{item.id}}" data-action="exception" bindtap="rowAction">停课／调课／补课</button></block>
          <block wx:if="{{section === 'semesters' && admin}}"><button size="mini" data-id="{{item.id}}" data-action="participants" bindtap="rowAction">选择参与班级</button><button wx:if="{{item.id !== activeSemesterId}}" size="mini" data-id="{{item.id}}" data-action="activate" bindtap="rowAction">启用为当前学期</button><text wx:else>组织当前学期</text></block>
        </view></block>
      </view>
      <view wx:if="{{view === 'records' && !visibleRows.length && !busy}}" class="empty"><view class="empty-icon">▤</view><view class="empty-title">{{!semesterId ? '尚未启用学期' : skipped ? '本周已跳过' : recordTab === 'mine' && weekSubmitted ? '本周还没有你的记录' : weekTotal ? '本周尚无听课记录' : '本周尚无听课任务'}}</view><view class="muted">{{!semesterId ? '管理员启用学期后可查看听课记录。' : skipped ? '本周不计漏交；已提交的历史记录仍会显示。' : weekTotal ? '成员提交后会显示在这里。' : '待正式安排听课任务后，在这里查看记录。'}}</view></view>
      <view wx:if="{{view !== 'records' && !visibleRows.length && !busy}}" class="empty"><view class="empty-icon">▤</view><view class="empty-title">{{searchText || applicationFilter === 'pending' && section === 'applications' ? '当前已加载资料没有匹配项' : '暂无资料'}}</view><view class="muted">{{view === 'courses' || section === 'courses' ? '配置真实课表后，在这里查看课程。' : '新增或提交后，会显示在这里。'}}</view></view>
      <view wx:if="{{cursor}}" class="muted small">还有资料未加载，搜索和筛选仅作用于已加载范围。</view><button wx:if="{{cursor}}" disabled="{{busy}}" bindtap="more">再加载50条</button>
    </block>
    <view wx:if="{{view === 'records' && manager && semesterId}}" class="card v2-record-export"><view class="section-title">本周汇总导出</view><view class="muted small">名单与原始数据分开导出；更正后请重新生成。</view><view class="v2-report-actions"><button disabled="{{busy}}" data-kind="txt" bindtap="exportReport">名单 TXT</button><button type="primary" disabled="{{busy}}" data-kind="xlsx" bindtap="exportReport">汇总 Excel</button></view><view class="link small v2-copy-report" bindtap="copyReport">直接复制请假／旷课名单</view><view wx:if="{{filePath}}" class="notice v2-report-file"><view class="muted small">已保存：{{filename}}</view><view class="link" bindtap="openReport">打开／分享文件 ›</view></view></view>
    <view wx:if="{{view === 'record' && record}}" class="v2-card">
      <view class="v2-title">{{record.data.classLabel}}</view><view>{{record.data.memberName}} · {{record.data.date}}</view><view>{{record.data.course.name}}</view>
      <view wx:for="{{recordFields}}" wx:key="label">{{item.label}}：{{item.value}}</view>
      <view>旷课名单：{{record.data.absentNames}}</view><view>请假名单：{{record.data.leaveNames}}</view><view>班风评价：{{record.data.evaluation}}</view><view>异常与反馈：{{record.data.feedback}}</view><view>教师建议：{{record.data.suggestion}}</view><view>其他情况：{{record.data.otherDescription}}</view>
      <view>首次提交：{{record.data.firstSubmittedAt}}</view><view wx:if="{{record.data.correctedAt}}">最近更正：{{record.data.correctedAt}} · {{record.data.reason}}</view>
      <view class="v2-photos"><image wx:for="{{photoUrls}}" wx:key="*this" src="{{item}}" mode="aspectFill" data-url="{{item}}" bindtap="previewPhoto"/></view>
      <button wx:if="{{canEdit}}" bindtap="editRecord">更正记录（须说明原因）</button><view wx:else class="v2-note">本人编辑期限为首次提交后不足24小时，超时请联系管理员纠错。</view>
      <button bindtap="history">{{versions.length ? (versionCursor ? '加载更多修改历史' : '查看修改历史') : '查看修改历史'}}</button>
      <view wx:for="{{versions}}" wx:key="id" class="v2-row"><view>{{item.detail}}</view><view>{{item.data.correctedAt || item.data.firstSubmittedAt}} · {{item.data.reason}}</view><view wx:for="{{item.historyFields}}" wx:for-item="metric" wx:key="label">{{metric.label}}：{{metric.value}}</view><view>旷课：{{item.data.absentNames}}；请假：{{item.data.leaveNames}}</view><view>班风：{{item.data.evaluation}}；反馈：{{item.data.feedback}}；建议：{{item.data.suggestion}}；其他：{{item.data.otherDescription}}</view><view>修改人：{{item.data.actorId}} · 版本 {{item.data.recordVersion}}</view><button size="mini" data-id="{{item.id}}" bindtap="versionPhotos">查看该版本照片</button></view>
    </view>

  </block>
  <block wx:if="{{view !== 'manage' || !memberId || maintenance}}"><include src="cloud-form.wxml" /></block>
  </block>
</view>
