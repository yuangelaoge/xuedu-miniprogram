<view class="home-page">
  <view class="home-heading">
    <view class="home-organization">西南大学 · 计信院学风督察小组</view>
    <view class="home-welcome">
      <text class="home-greeting">{{name}}，你好</text>
      <text class="home-role">{{role}}</text>
    </view>
  </view>

  <view class="week-card">
    <view class="week-copy">
      <view class="week-semester">{{semesterName}}</view>
      <view class="week-number">第 <text class="week-digits">{{week}}</text> 周</view>
      <view class="week-range">{{dates}}</view>
      <view class="week-mode"><view class="week-mode-dot"></view><text>{{modeLabel}}</text></view>
    </view>
    <view class="week-art" aria-hidden="true">
      <view class="art-sheet art-sheet-back"></view>
      <view class="art-sheet art-sheet-front">
        <view class="art-binding binding-left"></view>
        <view class="art-binding binding-right"></view>
        <view class="art-header"></view>
        <view class="art-grid">
          <view class="art-cell"></view><view class="art-cell"></view><view class="art-cell"></view>
          <view class="art-cell"></view><view class="art-cell art-cell-check"><view class="art-tick"></view></view><view class="art-cell"></view>
        </view>
      </view>
      <view class="art-spark spark-one"></view><view class="art-spark spark-two"></view>
    </view>
  </view>

  <view class="availability-card" hover-class="home-pressed" bindtap="availability" role="button" aria-label="填写或调整无课时间">
    <view class="availability-icon" aria-hidden="true"><view class="time-dial"><view class="time-hand"></view></view></view>
    <view class="availability-copy">
      <view class="availability-heading">无课时间<text wx:if="{{availabilityReady}}" class="availability-saved">已填写</text></view>
      <view class="availability-description">{{availabilityReady ? '第 ' + availabilityWeek + ' 周已填写，可继续调整' : '填写第 ' + availabilityWeek + ' 周空闲时段，方便安排听课'}}</view>
    </view>
    <view class="home-chevron" aria-hidden="true"></view>
  </view>

  <view class="home-section-heading">
    <view class="home-section-title">我的本周任务</view>
    <view class="home-section-link" hover-class="home-pressed" bindtap="schedule" role="button">全部安排<view class="home-chevron"></view></view>
  </view>
  <view wx:for="{{tasks}}" wx:key="id" class="home-task">
    <view class="task-topline">
      <view class="task-class">{{item.classLabel}}</view>
      <view class="task-status {{item.done ? 'task-status-done' : ''}}"><view class="task-status-dot"></view>{{item.done ? '已提交' : '待完成'}}</view>
    </view>
    <view class="task-course">{{item.course.name}}</view>
    <view class="task-detail"><text class="task-detail-label">时间</text><text class="task-detail-value">{{item.timeLabel}}</text></view>
    <view class="task-detail"><text class="task-detail-label">地点</text><text class="task-detail-value">{{item.course.classroom}}</text></view>
    <view class="task-detail"><text class="task-detail-label">教师</text><text class="task-detail-value">{{item.course.teacher}}</text></view>
    <view class="task-bottom">
      <text class="task-hint">{{item.done ? '本次听课已记录' : '听课后记得上传签字表'}}</text>
      <button wx:if="{{!item.done}}" class="task-button" hover-class="home-pressed" data-id="{{item.id}}" bindtap="submit">填写记录<text class="button-arrow">→</text></button>
      <button wx:else class="task-button task-button-done" hover-class="home-pressed" data-id="{{item.recordId}}" bindtap="record">查看记录<text class="button-arrow">→</text></button>
    </view>
  </view>
  <view wx:if="{{!tasks.length}}" class="home-empty">
    <view class="empty-paper" aria-hidden="true">
      <view class="empty-paper-line"></view><view class="empty-paper-line short-line"></view>
      <view class="empty-paper-badge"><view class="empty-check"></view></view>
    </view>
    <view class="home-empty-title">{{skipped ? '本周已跳过听课' : '本周暂无个人任务'}}</view>
    <view class="home-empty-description">{{skipped ? '本周无需听课，后续安排请留意周次更新' : '先填好无课时间，安排确认后会显示在这里'}}</view>
  </view>

  <block wx:if="{{manager}}">
    <view class="home-section-heading">
      <view class="home-section-title">全组本周进度</view>
      <view class="home-section-link" hover-class="home-pressed" bindtap="reports" role="button">查看汇总<view class="home-chevron"></view></view>
    </view>
    <view class="home-overview">
      <view class="overview-stat"><view class="overview-number">{{taskCount}}<text class="overview-unit">项</text></view><view class="overview-label">已安排任务</view></view>
      <view class="overview-stat"><view class="overview-number overview-blue">{{recordCount}}<text class="overview-unit">份</text></view><view class="overview-label">已提交记录</view></view>
      <view class="overview-stat"><view class="overview-number">{{coverage}}<text class="overview-unit">个</text></view><view class="overview-label">已覆盖教学班</view></view>
    </view>
  </block>

  <view class="home-reminder"><view class="reminder-icon">i</view><text>提交前请核对人数，并上传老师签字的听课表。</text></view>
  <view class="home-footer">{{cloudMode ? modeLabel + ' · 下拉刷新同步最新数据' : '本地体验版 · 示例人物与课程均为虚构'}}<view wx:if="{{!cloudMode}}">数据仅保存在当前设备，不跨设备同步</view></view>
</view>
