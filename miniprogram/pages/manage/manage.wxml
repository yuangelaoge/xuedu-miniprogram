<view class="page"><view class="eyebrow">MANAGEMENT</view><view class="title">管理工作台</view><view class="subtitle">{{semesterName}}</view><block wx:if="{{manager}}">
 <view class="filters"><view class="chip {{tab === 'members' ? 'active' : ''}}" data-tab="members" bindtap="tab">成员</view><view wx:if="{{admin}}" class="chip {{tab === 'courses' ? 'active' : ''}}" data-tab="courses" bindtap="tab">课表</view><view wx:if="{{admin}}" class="chip {{tab === 'semester' ? 'active' : ''}}" data-tab="semester" bindtap="tab">学期</view><view class="chip {{tab === 'audit' ? 'active' : ''}}" data-tab="audit" bindtap="tab">操作记录</view></view>
 <block wx:if="{{tab === 'members'}}">
   <view class="tabs"><view class="tab {{memberTab === 'pending' ? 'active' : ''}}" data-tab="pending" bindtap="memberTab">待审核 · {{pendingCount}}</view><view class="tab {{memberTab === 'current' ? 'active' : ''}}" data-tab="current" bindtap="memberTab">现有成员</view></view>
   <view class="search"><view class="search-symbol"></view><input placeholder="搜索姓名或学号" value="{{search}}" bindinput="search"/></view>
   <block wx:if="{{memberTab === 'pending'}}">
     <view wx:if="{{pending.length}}" class="card"><view class="row between"><text class="link" bindtap="selectAll">{{selected.length === pending.length ? '取消全选' : '选择全部'}}</text><text class="muted">已选 {{selected.length}} 人</text></view><view class="actions"><button class="secondary" data-decision="rejected" bindtap="review" disabled="{{!selected.length}}">批量驳回</button><button class="primary" data-decision="approved" bindtap="review" disabled="{{!selected.length}}">批量通过</button></view></view>
     <view wx:for="{{pending}}" wx:key="id" class="card application-card"><view class="row between"><view class="section-title">{{item.name}}</view><view class="pill {{item.selected ? '' : 'gray'}}" data-id="{{item.id}}" bindtap="selectApplication">{{item.selected ? '已选择 ✓' : '选择'}}</view></view><view class="muted" style="margin-top:14rpx">{{item.studentNo}} · {{item.classLabel}}</view><view class="actions"><button class="plain" data-id="{{item.id}}" data-decision="rejected" bindtap="review">驳回</button><button class="primary" data-id="{{item.id}}" data-decision="approved" bindtap="review">通过</button></view></view>
     <view wx:if="{{!pending.length}}" class="empty">{{search ? '没有匹配的申请' : '暂无待审核申请'}}</view>
   </block>
   <block wx:else>
     <view wx:for="{{members}}" wx:key="id" class="card member-card"><view class="row"><view class="avatar">{{item.name[0]}}</view><view class="grow"><view class="section-title">{{item.name}}</view><view class="muted small">{{item.studentNo}} · {{item.classLabel}}</view></view><text class="pill">{{item.roleLabel}}</text></view><view wx:if="{{item.role !== 'admin'}}" class="member-actions"><text wx:if="{{admin}}" class="link small" data-id="{{item.id}}" data-role="{{item.role === 'member' ? 'leader' : 'member'}}" bindtap="role">{{item.role === 'member' ? '设为组部长' : '撤销部长身份'}}</text><text wx:if="{{item.role === 'member'}}" class="danger small" data-id="{{item.id}}" bindtap="removeMember">删除组员</text></view></view>
     <view wx:if="{{!members.length}}" class="empty">没有匹配的成员</view>
   </block>
   <view class="notice">成员统一申请加入，不再导入名单。删除组员会取消未完成任务，历史记录和照片保留。</view>
 </block>
 <block wx:elif="{{tab === 'courses' && admin}}"><view class="notice">本地体验版先支持标准 JSON 课表导入。教务 Excel 的实际列格式待取得样表后适配，当前不会上传文件到服务器。</view><view class="card"><view class="row between"><view class="section-title">导入学期课表</view><text class="link small" bindtap="example">载入格式示例</text></view><view class="muted small" style="margin-top:14rpx">粘贴内容或选择文件，先预览，确认后保存。重复课程或班级 ID 会被拦截。</view><textarea class="input import-text" placeholder="粘贴 JSON 内容…" value="{{text}}" bindinput="input" maxlength="100000" auto-height="true"/><view class="actions"><button class="plain" bindtap="file">选择文件</button><button class="secondary" bindtap="preview">解析预览</button></view></view>
 <view wx:if="{{previewed}}" class="card"><view class="section-title">导入预览 · {{preview.length}} 条</view><view class="muted">新增班级 {{classCount}} 个</view><view wx:if="{{errors.length}}" class="notice warn"><view wx:for="{{errors}}" wx:key="*this">{{item}}</view></view><view wx:for="{{preview}}" wx:key="index" class="menu-row"><view><view>{{item.name}}</view><view class="muted small">{{item.detail}}</view></view></view><button class="primary" style="margin-top:22rpx" bindtap="commit" disabled="{{errors.length > 0 || !preview.length}}">确认导入</button></view>
 </block>
 <block wx:elif="{{tab === 'semester' && admin}}"><view class="card"><view class="section-title">切换学期</view><picker range="{{semesters}}" range-key="name" value="{{semesterIndex}}" bindchange="semester"><view class="input row between" style="margin-top:22rpx"><text>{{semesterName}}</text><text class="chevron">›</text></view></picker><view class="muted small" style="margin-top:16rpx">新学期单独导入课表，历史记录始终保留。</view></view><view class="card"><view class="section-title">建立新学期</view><view class="field"><view class="field-label">学期名称</view><input class="input" value="{{form.name}}" data-key="name" bindinput="form"/></view><view class="field"><view class="field-label">第一周周一</view><picker mode="date" value="{{form.startDate}}" data-key="startDate" bindchange="form"><view class="input">{{form.startDate}}</view></picker></view><view class="field"><view class="field-label">参与年级</view><input class="input" value="{{form.grades}}" data-key="grades" bindinput="form" placeholder="例如：25,26,27"/></view><view class="field"><view class="field-label">教学周数（1–30）</view><input class="input" type="number" value="{{form.weeks}}" data-key="weeks" bindinput="form"/></view><view class="field"><view class="field-label">每周上课天数（5–7）</view><input class="input" type="number" value="{{form.days}}" data-key="days" bindinput="form"/></view><view class="field"><view class="field-label">每天节数（1–16）</view><input class="input" type="number" value="{{form.periods}}" data-key="periods" bindinput="form"/></view><button class="primary" style="margin-top:28rpx" bindtap="createSemester">建立并切换到新学期</button></view></block>
 <block wx:elif="{{tab === 'audit'}}"><view wx:for="{{logs}}" wx:key="index" class="card"><view class="row between"><text class="section-title">{{item.action}}</text><text class="pill">{{item.actor}}</text></view><view class="course-meta" style="margin-top:14rpx">{{item.detail}}</view><view class="muted small">{{item.time}}</view></view><view wx:if="{{!logs.length}}" class="empty">还没有操作记录</view><view wx:if="{{trialMode && admin}}" class="card"><view class="section-title">试用结束后清理</view><view class="muted" style="margin:16rpx 0">仅清理多人试用数据，先显示范围并二次确认。不会清理正式环境。</view><button class="plain" bindtap="cleanupTrial">查看试用数据清理范围</button></view></block><view class="footer-note">{{cloudMode ? modeLabel + ' · 管理操作同步到云端' : '所有管理操作当前仅作用于本设备的体验数据'}}</view></block></view>
