<view class="page">
  <view class="eyebrow">JOIN OUR TEAM</view>
  <view class="title">加入学风督察小组</view>
  <view class="subtitle">西南大学 · 计信院</view>
  <view class="notice" style="margin-top:30rpx">{{cloudMode ? modeLabel + '：微信身份自动关联，资料提交后由管理人员审核。试用数据不会带入正式版。' : '本地流程演示：尚未连接微信身份与云端审核，不能供其他手机扫码入组。'}}</view>
  <view wx:if="{{connecting}}" class="notice">正在连接云端…</view>
  <view wx:if="{{connectionError}}" class="notice warn" bindtap="refresh">{{connectionError}} · 点击重试</view>
  <view class="card">
    <view class="section-title">{{statusTitle}}</view>
    <view class="muted" style="margin-top:16rpx">{{statusText}}</view>
    <view wx:if="{{reason && status === 'rejected'}}" class="notice warn" style="margin-top:20rpx">驳回原因：{{reason}}</view>
    <block wx:if="{{status === 'new' || status === 'rejected'}}">
      <view class="field"><view class="field-label">姓名</view><input class="input" value="{{name}}" data-key="name" bindinput="input" placeholder="填写真实姓名" maxlength="30"/></view>
      <view class="field"><view class="field-label">学号</view><input class="input" value="{{studentNo}}" data-key="studentNo" bindinput="input" placeholder="填写学号" maxlength="32"/></view>
      <view class="field"><view class="field-label">所属班级</view><picker range="{{classes}}" range-key="label" value="{{classIndex < 0 ? 0 : classIndex}}" bindchange="chooseClass"><view class="input">{{classIndex < 0 ? '请选择班级' : classes[classIndex].label}}</view></picker></view>
      <view wx:if="{{!classes.length}}" class="notice warn">尚无班级资料，请联系管理员先维护课表与班级。</view>
      <button class="primary" style="margin-top:28rpx" bindtap="submit" disabled="{{busy || !classes.length}}">{{status === 'rejected' ? '修改后重新申请' : '提交入组申请'}}</button>
      <view class="muted small" style="margin-top:16rpx">提交的姓名、学号与班级用于入组核对和后续排班，由管理员及组部长查看。</view>
    </block>
    <block wx:elif="{{status === 'pending'}}"><view class="field">{{name}} · {{studentNo}}</view><button class="secondary" bindtap="refresh">刷新审核状态</button></block>
  </view>
  <view wx:if="{{!cloudMode}}" class="footer-note" bindtap="openDemo" style="padding:22rpx">开发体验 ›</view>
  <view wx:else class="footer-note" bindtap="copyIdentity" style="padding:22rpx">首次配置管理员：复制本人微信标识</view>
</view>
