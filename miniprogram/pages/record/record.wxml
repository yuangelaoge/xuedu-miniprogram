<block wx:if="{{cloudMode}}"><include src="../../templates/cloud.wxml" /></block>
<block wx:else>
<view class="page"><view class="eyebrow">OBSERVATION RECORD</view><view class="title">听课记录</view><block wx:if="{{canView}}"><view class="card"><view class="row between"><text class="pill green">已提交</text><text class="muted small">第 {{record.week}} 周</text></view><view class="course-title">{{record.course.name}}</view><view class="course-meta">{{record.classLabel}} · {{record.date}}</view><view class="course-meta">听课成员：{{record.memberName}}</view><view class="divider"></view><view class="row between"><text>出勤率</text><text class="number" style="font-size:36rpx">{{attendance}}</text></view><view wx:for="{{fields}}" wx:key="label" class="menu-row"><text class="muted">{{item.label}}</text><text>{{item.value}}</text></view></view>
 <view class="card"><view class="field-label">旷课名单</view><view class="muted">{{record.absentNames}}</view><view class="field-label" style="margin-top:22rpx">请假名单</view><view class="muted">{{record.leaveNames}}</view></view>
 <view class="card"><view class="field-label">其他情况</view><view class="muted">{{record.otherDescription || '未填写'}}</view><view class="field-label" style="margin-top:22rpx">班风评价</view><view class="muted">{{record.evaluation || '未填写'}}</view><view class="field-label" style="margin-top:22rpx">异常及反馈</view><view class="muted">{{record.feedback || '未填写'}}</view><view class="field-label" style="margin-top:22rpx">教师建议</view><view class="muted">{{record.suggestion || '未填写'}}</view></view>
 <view class="section section-title">老师签字凭证</view><image wx:for="{{photos}}" wx:key="*this" src="{{item}}" mode="widthFix" style="width:100%;border-radius:20rpx;margin-bottom:20rpx" data-path="{{item}}" bindtap="preview"/><view class="footer-note">照片与本次记录绑定 · 点击查看原图</view></block><view wx:else class="empty">记录不可用或无权查看</view></view>

</block>
