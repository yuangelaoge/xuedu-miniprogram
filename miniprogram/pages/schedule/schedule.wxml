<view class="page"><view class="eyebrow">WEEKLY SCHEDULE</view><view class="row between"><view class="title">听课安排</view><text class="pill {{draft ? 'amber' : status === 'confirmed' ? 'green' : 'gray'}}">{{statusLabel}}</text></view><view class="row between subtitle"><text>提前安排每次听课</text><text class="link" bindtap="courses">课程总表 ›</text></view>
 <view class="week-switch"><view class="week-arrow" data-delta="-1" bindtap="move">‹</view><view class="week-center"><view class="week-title">第 {{week}} 周</view><view class="week-dates">{{dates}}</view></view><view class="week-arrow" data-delta="1" bindtap="move">›</view></view>
 <view wx:if="{{manager}}" class="card"><view class="row between"><text class="section-title">排班工作台</text><text class="muted small">{{submitted}} 人已填无课时间</text></view><view class="subtitle small">非本班 · 每人至多一次 · 优先覆盖教学班</view><view wx:if="{{draft}}" class="notice warn">v{{revision}} 草稿尚未生效{{hasPublished ? '，原正式安排仍保留' : ''}}。请核对后手动确认。</view><view class="actions"><button class="{{draft ? 'plain' : 'primary'}}" bindtap="generate">{{status === 'empty' || status === 'skipped' ? '生成排班' : '重新生成'}}</button><button wx:if="{{draft}}" class="primary" bindtap="confirm">确认排班</button><button wx:elif="{{admin}}" class="plain" bindtap="skip">跳过本周</button></view><view wx:if="{{admin && draft}}" class="link small" style="text-align:center;margin-top:24rpx" bindtap="skip">假期等情况，跳过本周</view></view>
 <view wx:if="{{status === 'skipped'}}" class="notice warn">本周不安排听课：{{reason}}</view>
 <view class="search"><view class="search-symbol"></view><input placeholder="搜索姓名、班级或课程" bindinput="search" value="{{search}}"/></view>
 <view class="section row between"><text class="section-title">{{draft ? '拟安排任务' : '正式任务'}} · {{total}}</text><text class="link" bindtap="availability">填写本周无课时间 ›</text></view>
 <view wx:for="{{tasks}}" wx:key="id" class="card"><view class="row"><view class="avatar">{{item.memberName[0]}}</view><view class="grow"><view>{{item.memberName}} <text wx:if="{{item.mine}}" class="pill">我</text></view><view class="muted small">{{item.classLabel}}</view></view><text class="pill {{draft ? 'amber' : item.done ? 'green' : 'gray'}}">{{draft ? '待确认' : item.done ? '已提交' : '待完成'}}</text></view><view class="divider"></view><view class="course-title">{{item.course.name}}</view><view class="course-meta">{{item.timeLabel}} · {{item.course.classroom}}</view><view wx:if="{{item.mine && !item.done && !draft}}" class="actions"><button class="secondary" bindtap="submit" data-id="{{item.id}}">填写听课记录</button></view></view>
 <view wx:if="{{!tasks.length}}" class="empty"><view class="empty-icon">▦</view><view class="empty-title">{{status === 'empty' ? '本周安排尚未发布' : '暂无匹配任务'}}</view><view class="muted">{{manager ? '检查无课时间与课表后，生成待确认方案。' : '请先填写无课时间，等待管理人员确认。'}}</view></view>
 <view wx:if="{{uncovered.length && manager}}" class="card"><view class="section-title">未覆盖教学班 · {{uncovered.length}}</view><view wx:for="{{uncovered}}" wx:key="label" style="margin-top:22rpx"><view>{{item.label}}</view><view class="muted">{{item.reason}}</view></view></view>
 <view class="footer-note">生成不会自动发布 · 每次重生成都需重新确认</view></view>
